{% comment %}
  Franja de medios de pago.

  Accepts:
  - block: {Object} Bloque con los settings (required)

  Por defecto usa la imagen de marca que viene en assets/. Si el bloque
  trae una imagen propia (otra tienda, otros medios de pago) esa manda.
{% endcomment %}

{{ 'component-payment-methods.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign alt_text = block.settings.alt | default: 'Medios de pago aceptados'
  assign custom = block.settings.banner_image
-%}

<div class="pm-banner" {{ block.shopify_attributes }}>
  {%- if custom != blank -%}
    {{
      custom
      | image_url: width: 1400
      | image_tag:
        class: 'pm-banner__img',
        loading: 'lazy',
        widths: '400, 700, 1100, 1400',
        sizes: '(min-width: 750px) 560px, 100vw',
        alt: alt_text
    }}
  {%- else -%}
    <img
      class="pm-banner__img"
      src="{{ 'payment-methods-banner.png' | asset_img_url: '1400x' }}"
      srcset="
        {{ 'payment-methods-banner.png' | asset_img_url: '400x' }} 400w,
        {{ 'payment-methods-banner.png' | asset_img_url: '700x' }} 700w,
        {{ 'payment-methods-banner.png' | asset_img_url: '1100x' }} 1100w,
        {{ 'payment-methods-banner.png' | asset_img_url: '1400x' }} 1400w
      "
      sizes="(min-width: 750px) 560px, 100vw"
      width="1400"
      height="296"
      loading="lazy"
      decoding="async"
      alt="{{ alt_text | escape }}"
    >
  {%- endif -%}
</div>
