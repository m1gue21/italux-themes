{%- comment -%}
  Sección de reseñas y calificaciones con modal de estadísticas.
  Estilo: grid de cards, contador, modal con distribución de estrellas.
{%- endcomment -%}

{%- assign blocks_arr = section.blocks | where: 'type', 'review' -%}
{%- assign total_reviews = blocks_arr.size -%}
{%- assign sum_rating = 0 -%}
{%- assign count_5 = 0 -%}
{%- assign count_4 = 0 -%}
{%- assign count_3 = 0 -%}
{%- assign count_2 = 0 -%}
{%- assign count_1 = 0 -%}
{%- for block in blocks_arr -%}
  {%- assign r = block.settings.rating | default: 5 | round -%}
  {%- assign sum_rating = sum_rating | plus: r -%}
  {%- case r -%}
    {%- when 5 -%}{%- assign count_5 = count_5 | plus: 1 -%}
    {%- when 4 -%}{%- assign count_4 = count_4 | plus: 1 -%}
    {%- when 3 -%}{%- assign count_3 = count_3 | plus: 1 -%}
    {%- when 2 -%}{%- assign count_2 = count_2 | plus: 1 -%}
    {%- else -%}{%- assign count_1 = count_1 | plus: 1 -%}
  {%- endcase -%}
{%- endfor -%}
{%- assign avg_rating = 0 -%}
{%- assign avg_rating_display = '0' -%}
{%- if total_reviews > 0 -%}
  {%- assign avg_x = sum_rating | times: 10 | divided_by: total_reviews -%}
  {%- assign avg_int = avg_x | divided_by: 10 -%}
  {%- assign avg_dec = avg_x | modulo: 10 -%}
  {%- assign avg_rating = avg_int -%}
  {%- capture avg_rating_display -%}{{ avg_int }}.{{ avg_dec }}{%- endcapture -%}
{%- endif -%}
{%- assign max_count = count_5 -%}
{%- if count_4 > max_count -%}{%- assign max_count = count_4 -%}{%- endif -%}
{%- if count_3 > max_count -%}{%- assign max_count = count_3 -%}{%- endif -%}
{%- if count_2 > max_count -%}{%- assign max_count = count_2 -%}{%- endif -%}
{%- if count_1 > max_count -%}{%- assign max_count = count_1 -%}{%- endif -%}
{%- if max_count == 0 -%}{%- assign max_count = 1 -%}{%- endif -%}
{%- assign bar_divisor = total_reviews -%}
{%- if bar_divisor == 0 -%}{%- assign bar_divisor = 1 -%}{%- endif -%}

{%- comment -%} Paginacion: techo de total_reviews / per_page {%- endcomment -%}
{%- assign per_page = section.settings.reviews_per_page | default: 6 -%}
{%- if per_page < 1 -%}{%- assign per_page = 6 -%}{%- endif -%}
{%- assign total_pages = total_reviews | plus: per_page | minus: 1 | divided_by: per_page -%}

{%- style -%}
  .reviews-ratings-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media (min-width: 750px) {
    .reviews-ratings-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .reviews-ratings-{{ section.id }} {
    overflow-x: hidden;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }
  .reviews-ratings-{{ section.id }} .rr-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
    min-width: 0;
  }
  .reviews-ratings-{{ section.id }} .rr-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }
  .reviews-ratings-{{ section.id }} .rr-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }
  .reviews-ratings-{{ section.id }} .rr-stars {
    display: flex;
    gap: 2px;
    color: #e5b318;
  }
  .reviews-ratings-{{ section.id }} .rr-stars svg {
    width: 24px;
    height: 24px;
  }
  .reviews-ratings-{{ section.id }} .rr-stars .rr-star-empty {
    color: #e5e5e5;
  }
  .reviews-ratings-{{ section.id }} .rr-count {
    font-size: 1rem;
    font-weight: 500;
    color: #333;
  }
  .reviews-ratings-{{ section.id }} .rr-chevron {
    width: 20px;
    height: 20px;
    color: #666;
    transition: transform 0.2s;
  }
  .reviews-ratings-{{ section.id }} .rr-summary[aria-expanded="true"] .rr-chevron {
    transform: rotate(180deg);
  }
  .reviews-ratings-{{ section.id }} .rr-modal {
    display: none;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(0,0,0,0.08);
  }
  .reviews-ratings-{{ section.id }} .rr-modal[data-open="true"] {
    display: block;
  }
  .reviews-ratings-{{ section.id }} .rr-modal-top {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .reviews-ratings-{{ section.id }} .rr-modal-star {
    width: 48px;
    height: 48px;
    color: #e5b318;
  }
  .reviews-ratings-{{ section.id }} .rr-modal-avg {
    font-size: 2rem;
    font-weight: 700;
    color: #1a1a1a;
  }
  .reviews-ratings-{{ section.id }} .rr-modal-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }
  .reviews-ratings-{{ section.id }} .rr-modal-bar-wrap {
    flex: 1;
    min-width: 80px;
    height: 12px;
    background: #e0e0e0;
    border-radius: 6px;
    overflow: hidden;
    display: block;
  }
  .reviews-ratings-{{ section.id }} .rr-modal-bar {
    display: block;
    height: 100%;
    background: #c9a227;
    border-radius: 6px;
    transition: width 0.3s ease;
    box-sizing: border-box;
  }
  .reviews-ratings-{{ section.id }} .rr-modal-row .rr-stars {
    min-width: 110px;
    font-size: 1.5rem;
    color: #e5b318;
    letter-spacing: 2px;
  }
  .reviews-ratings-{{ section.id }} .rr-modal-row .rr-num {
    min-width: 28px;
    font-weight: 500;
    color: #666;
  }
  /* El atributo hidden pierde contra display:flex/grid del autor, hay que forzarlo. */
  .reviews-ratings-{{ section.id }} .rr-card[hidden],
  .reviews-ratings-{{ section.id }} .rr-page-num[hidden],
  .reviews-ratings-{{ section.id }} .rr-page-dots[hidden] {
    display: none !important;
  }
  .reviews-ratings-{{ section.id }} .rr-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1.75rem;
  }
  .reviews-ratings-{{ section.id }} .rr-page-numbers {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .reviews-ratings-{{ section.id }} .rr-page-arrow,
  .reviews-ratings-{{ section.id }} .rr-page-num {
    min-width: 38px;
    height: 38px;
    padding: 0 0.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 8px;
    background: #fff;
    color: #333;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .reviews-ratings-{{ section.id }} .rr-page-arrow svg {
    width: 18px;
    height: 18px;
  }
  .reviews-ratings-{{ section.id }} .rr-page-arrow:hover:not(:disabled),
  .reviews-ratings-{{ section.id }} .rr-page-num:hover:not(.is-current) {
    border-color: #c9a227;
    color: #8a6f18;
  }
  .reviews-ratings-{{ section.id }} .rr-page-arrow:focus-visible,
  .reviews-ratings-{{ section.id }} .rr-page-num:focus-visible {
    outline: 2px solid #c9a227;
    outline-offset: 2px;
  }
  .reviews-ratings-{{ section.id }} .rr-page-num.is-current {
    background: #c9a227;
    border-color: #c9a227;
    color: #fff;
    cursor: default;
  }
  .reviews-ratings-{{ section.id }} .rr-page-arrow:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .reviews-ratings-{{ section.id }} .rr-page-dots {
    padding: 0 0.15rem;
    color: #999;
    user-select: none;
  }
  .reviews-ratings-{{ section.id }} .rr-page-status {
    margin: 0.75rem 0 0;
    text-align: center;
    font-size: 0.85rem;
    color: #777;
  }
  @media (max-width: 749px) {
    .reviews-ratings-{{ section.id }} .rr-page-arrow,
    .reviews-ratings-{{ section.id }} .rr-page-num {
      min-width: 34px;
      height: 34px;
      padding: 0 0.45rem;
      font-size: 0.9rem;
    }
  }
  .reviews-ratings-{{ section.id }} .rr-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    min-width: 0;
  }
  @media (min-width: 750px) {
    .reviews-ratings-{{ section.id }} .rr-grid {
      gap: 1rem;
    }
  }
  .reviews-ratings-{{ section.id }} .rr-card {
    background: #fff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 10px;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
    overflow: hidden;
  }
  .reviews-ratings-{{ section.id }} .rr-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .reviews-ratings-{{ section.id }} .rr-card-author {
    font-weight: 700;
    font-size: 1.08rem;
    line-height: 1.25;
    color: #1a1a1a;
    letter-spacing: -0.01em;
  }
  .reviews-ratings-{{ section.id }} .rr-card-date {
    font-size: 0.8rem;
    line-height: 1.3;
    color: #666;
  }
  .reviews-ratings-{{ section.id }} .rr-card-verified {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #1877f2;
    margin-left: 4px;
  }
  .reviews-ratings-{{ section.id }} .rr-card-verified-badge {
    width: 18px;
    height: 18px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .reviews-ratings-{{ section.id }} .rr-card-verified-text {
    color: #1877f2;
  }
  .reviews-ratings-{{ section.id }} .rr-card-img-wrap {
    width: 100%;
    max-width: 200px;
    aspect-ratio: 1;
    height: auto;
    margin: 0.35rem 0 0.5rem 0;
    border-radius: 10px;
    overflow: hidden;
    background: #f0f0f0;
    display: block;
    min-width: 0;
  }
  .reviews-ratings-{{ section.id }} .rr-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    vertical-align: top;
  }
  .reviews-ratings-{{ section.id }} .rr-card-body {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .reviews-ratings-{{ section.id }} .rr-card-text {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
    color: #1a1a1a;
    hyphens: auto;
    text-align: left;
    margin: 0;
    min-width: 0;
    overflow-wrap: break-word;
  }
  .reviews-ratings-{{ section.id }} .rr-card .rr-stars svg {
    width: 20px;
    height: 20px;
  }
  @media (max-width: 749px) {
    .reviews-ratings-{{ section.id }} .rr-card {
      padding: 1.15rem;
    }
    .reviews-ratings-{{ section.id }} .rr-card-author {
      font-size: 1.02rem;
    }
    .reviews-ratings-{{ section.id }} .rr-card-img-wrap {
      max-width: 160px;
    }
    .reviews-ratings-{{ section.id }} .rr-card-text {
      font-size: 0.95rem;
    }
  }
{%- endstyle -%}

<section class="reviews-ratings-{{ section.id }} color-{{ section.settings.color_scheme }} gradient isolate" aria-label="Reseñas y calificaciones">
  <div class="rr-inner">
    <div class="rr-header">
      <button type="button" class="rr-summary" aria-expanded="false" data-rr-toggle="{{ section.id }}" aria-controls="rr-modal-{{ section.id }}">
        <span class="rr-stars" aria-hidden="true">
          {%- for star_idx in (1..5) -%}
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          {%- endfor -%}
        </span>
        <span class="rr-count">{{ total_reviews }} Reseñas</span>
        <svg class="rr-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </button>
    </div>

    <div id="rr-modal-{{ section.id }}" class="rr-modal" data-open="false" role="dialog" aria-label="Distribución de calificaciones">
      <div class="rr-modal-top">
        <svg class="rr-modal-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <span class="rr-modal-avg">{{ avg_rating_display }}</span>
      </div>
      <div class="rr-modal-row">
        <span class="rr-stars">★★★★★</span>
        <div class="rr-modal-bar-wrap"><div class="rr-modal-bar" style="--rr-bar-width: {{ count_5 | times: 100 | divided_by: bar_divisor }}%; width: {{ count_5 | times: 100 | divided_by: bar_divisor }}%;"></div></div>
        <span class="rr-num">({{ count_5 }})</span>
      </div>
      <div class="rr-modal-row">
        <span class="rr-stars">★★★★☆</span>
        <div class="rr-modal-bar-wrap"><div class="rr-modal-bar" style="--rr-bar-width: {{ count_4 | times: 100 | divided_by: bar_divisor }}%; width: {{ count_4 | times: 100 | divided_by: bar_divisor }}%;"></div></div>
        <span class="rr-num">({{ count_4 }})</span>
      </div>
      <div class="rr-modal-row">
        <span class="rr-stars">★★★☆☆</span>
        <div class="rr-modal-bar-wrap"><div class="rr-modal-bar" style="--rr-bar-width: {{ count_3 | times: 100 | divided_by: bar_divisor }}%; width: {{ count_3 | times: 100 | divided_by: bar_divisor }}%;"></div></div>
        <span class="rr-num">({{ count_3 }})</span>
      </div>
      <div class="rr-modal-row">
        <span class="rr-stars">★★☆☆☆</span>
        <div class="rr-modal-bar-wrap"><div class="rr-modal-bar" style="--rr-bar-width: {{ count_2 | times: 100 | divided_by: bar_divisor }}%; width: {{ count_2 | times: 100 | divided_by: bar_divisor }}%;"></div></div>
        <span class="rr-num">({{ count_2 }})</span>
      </div>
      <div class="rr-modal-row">
        <span class="rr-stars">★☆☆☆☆</span>
        <div class="rr-modal-bar-wrap"><div class="rr-modal-bar" style="--rr-bar-width: {{ count_1 | times: 100 | divided_by: bar_divisor }}%; width: {{ count_1 | times: 100 | divided_by: bar_divisor }}%;"></div></div>
        <span class="rr-num">({{ count_1 }})</span>
      </div>
    </div>

    <div class="rr-grid">
      {%- for block in blocks_arr -%}
        {%- assign r = block.settings.rating | default: 5 | round -%}
        {%- assign card_page = forloop.index0 | divided_by: per_page | plus: 1 -%}
        <article
          class="rr-card"
          data-rr-card
          data-rr-page="{{ card_page }}"
          {% if card_page > 1 %}hidden{% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="rr-card-top">
            <div>
              <p class="rr-card-author">
                {{ block.settings.author_name | default: 'Cliente' }}
                {%- if block.settings.verified -%}
                  <span class="rr-card-verified">
                    <img src="{{ 'verified.png' | asset_url }}" alt="" width="18" height="18" class="rr-card-verified-badge" loading="lazy">
                    <span class="rr-card-verified-text">Verificado</span>
                  </span>
                {%- endif -%}
              </p>
              <p class="rr-card-date">{{ block.settings.date | default: 'Hace poco' }}</p>
            </div>
          </div>
          <div class="rr-stars">
            {%- for star_idx in (1..5) -%}
              {%- if star_idx <= r -%}
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              {%- else -%}
                <svg class="rr-star-empty" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if block.settings.image != blank or block.settings.image_url != blank -%}
            <div class="rr-card-img-wrap">
              {%- if block.settings.image_url != blank -%}
                <img class="rr-card-img" src="{{ block.settings.image_url }}" alt="" width="240" height="160" loading="lazy">
              {%- else -%}
                <img class="rr-card-img" src="{{ block.settings.image | image_url: width: 480 }}" alt="" width="240" height="160" loading="lazy">
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="rr-card-body">
            <p class="rr-card-text">{{ block.settings.content | default: 'Excelente producto.' }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if total_pages > 1 -%}
      <nav class="rr-pagination" data-rr-pagination aria-label="Paginación de reseñas">
        <button type="button" class="rr-page-arrow" data-rr-prev aria-label="Página anterior" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>

        <div class="rr-page-numbers" data-rr-numbers>
          {%- for page_i in (1..total_pages) -%}
            <button
              type="button"
              class="rr-page-num{% if forloop.first %} is-current{% endif %}"
              data-rr-page-btn="{{ page_i }}"
              {% if forloop.first %}aria-current="page"{% endif %}
              aria-label="Página {{ page_i }}"
            >{{ page_i }}</button>
          {%- endfor -%}
        </div>

        <button type="button" class="rr-page-arrow" data-rr-next aria-label="Página siguiente">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </nav>

      <p class="rr-page-status" data-rr-status role="status" aria-live="polite"></p>
    {%- endif -%}
  </div>
</section>

{%- comment -%} Sin JS: se muestran todas las resenas y se oculta el paginador. {%- endcomment -%}
<noscript>
  <style>
    .reviews-ratings-{{ section.id }} .rr-card[hidden] { display: flex !important; }
    .reviews-ratings-{{ section.id }} .rr-pagination,
    .reviews-ratings-{{ section.id }} .rr-page-status { display: none !important; }
  </style>
</noscript>

<script>
  (function () {
    var root = document.querySelector('.reviews-ratings-{{ section.id }}');
    if (!root || root.dataset.rrPaginationReady === 'true') return;

    var nav = root.querySelector('[data-rr-pagination]');
    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-rr-card]'));
    if (!nav || !cards.length) return;

    root.dataset.rrPaginationReady = 'true';

    var perPage = {{ per_page }};
    var numbers = Array.prototype.slice.call(nav.querySelectorAll('[data-rr-page-btn]'));
    var numbersWrap = nav.querySelector('[data-rr-numbers]');
    var prevBtn = nav.querySelector('[data-rr-prev]');
    var nextBtn = nav.querySelector('[data-rr-next]');
    var status = root.querySelector('[data-rr-status]');
    var totalPages = numbers.length;
    var current = 1;

    // Puntos suspensivos para no listar 20 paginas seguidas.
    var dotsLeft = document.createElement('span');
    dotsLeft.className = 'rr-page-dots';
    dotsLeft.setAttribute('aria-hidden', 'true');
    dotsLeft.textContent = '\u2026';
    var dotsRight = dotsLeft.cloneNode(true);
    if (totalPages > 3 && numbersWrap) {
      numbersWrap.insertBefore(dotsLeft, numbers[1]);
      numbersWrap.insertBefore(dotsRight, numbers[totalPages - 1]);
    }

    function render(page, moveFocus) {
      current = Math.min(Math.max(page, 1), totalPages);

      cards.forEach(function (card, i) {
        card.hidden = Math.floor(i / perPage) + 1 !== current;
      });

      numbers.forEach(function (btn, i) {
        var n = i + 1;
        var visible = n === 1 || n === totalPages || Math.abs(n - current) <= 1;
        btn.hidden = !visible;
        btn.classList.toggle('is-current', n === current);
        if (n === current) {
          btn.setAttribute('aria-current', 'page');
        } else {
          btn.removeAttribute('aria-current');
        }
      });

      dotsLeft.hidden = current <= 3;
      dotsRight.hidden = current >= totalPages - 2;

      prevBtn.disabled = current === 1;
      nextBtn.disabled = current === totalPages;

      if (status) {
        var shown = cards.filter(function (c) { return !c.hidden; }).length;
        var from = (current - 1) * perPage + 1;
        status.textContent =
          'Mostrando ' + from + '\u2013' + (from + shown - 1) + ' de ' + cards.length +
          ' rese\u00f1as \u00b7 p\u00e1gina ' + current + ' de ' + totalPages;
      }

      if (moveFocus) {
        var top = root.getBoundingClientRect().top + window.pageYOffset - 100;
        window.scrollTo({ top: top, behavior: 'smooth' });
      }
    }

    nav.addEventListener('click', function (e) {
      var numBtn = e.target.closest('[data-rr-page-btn]');
      if (numBtn) return render(parseInt(numBtn.dataset.rrPageBtn, 10), true);
      if (e.target.closest('[data-rr-prev]')) return render(current - 1, true);
      if (e.target.closest('[data-rr-next]')) return render(current + 1, true);
    });

    // En el editor de temas, al seleccionar una resena saltamos a su pagina.
    document.addEventListener('shopify:block:select', function (e) {
      if (!root.contains(e.target)) return;
      var card = e.target.closest('[data-rr-card]');
      var idx = cards.indexOf(card);
      if (idx >= 0) render(Math.floor(idx / perPage) + 1, false);
    });

    render(1, false);
  })();
</script>

<script>
  document.querySelectorAll('[data-rr-toggle]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = this.getAttribute('data-rr-toggle');
      var modal = document.getElementById('rr-modal-' + id);
      var open = modal.getAttribute('data-open') === 'true';
      modal.setAttribute('data-open', !open);
      btn.setAttribute('aria-expanded', !open);
    });
  });
</script>

