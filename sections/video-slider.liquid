{%- comment -%}
  Video slider: marquesina infinita + animación suave. Solo CSS con prefijo video-slider- para no afectar el resto del tema.
{%- endcomment -%}

{%- style -%}
  .video-slider-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    overflow-x: hidden;
    width: 100%;
  }
  @media (min-width: 750px) {
    .video-slider-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .video-slider-section-{{ section.id }} .video-slider-inner {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .video-slider-section-{{ section.id }} .video-slider-title {
    text-align: center;
    white-space: nowrap;
  }
  @media (min-width: 768px) {
    .video-slider-section-{{ section.id }} .video-slider-title {
      text-align: left;
    }
  }
  .video-slider-section-{{ section.id }} .video-slider-mask {
    overflow: hidden;
    width: 100%;
    min-width: 0;
  }
  .video-slider-section-{{ section.id }} .video-slider-track-{{ section.id }} {
    display: flex;
    gap: 1rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    width: max-content;
    animation: video-slider-marquee-{{ section.id }} 32s linear infinite;
  }
  .video-slider-section-{{ section.id }} .video-slider-track-{{ section.id }}:hover {
    animation-play-state: paused;
  }
  @keyframes video-slider-marquee-{{ section.id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .video-slider-section-{{ section.id }} .video-slider-card {
    flex-shrink: 0;
    width: 200px;
    aspect-ratio: 9 / 16;
    border-radius: 1rem;
    border: 1px solid rgba(251, 191, 36, 0.4);
    background: #fff;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    overflow: hidden;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .video-slider-section-{{ section.id }} .video-slider-card:nth-child(odd) {
    animation: video-slider-float-down-{{ section.id }} 3s ease-in-out infinite;
  }
  .video-slider-section-{{ section.id }} .video-slider-card:nth-child(even) {
    animation: video-slider-float-up-{{ section.id }} 3s ease-in-out infinite;
  }
  @keyframes video-slider-float-down-{{ section.id }} {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(14px); }
  }
  @keyframes video-slider-float-up-{{ section.id }} {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-14px); }
  }
  @media (min-width: 640px) {
    .video-slider-section-{{ section.id }} .video-slider-card {
      width: 220px;
    }
  }
  .video-slider-section-{{ section.id }} .video-slider-card:hover {
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    transform: scale(1.02);
  }
  .video-slider-section-{{ section.id }} .video-slider-card video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  body.template-product .product__media-wrapper .slider-buttons,
  body.template-product .product__media-wrapper .slider-counter {
    display: none !important;
  }
{%- endstyle -%}

<section
  class="video-slider-section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient isolate"
  aria-label="Videos"
>
  <div class="video-slider-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="title inline-richtext {{ section.settings.heading_size }} video-slider-title">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
  </div>

  <div class="video-slider-mask">
    <div
      id="video-slider-track-{{ section.id }}"
      class="video-slider-track-{{ section.id }}"
    >
      {%- for copy in (1..2) -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'video' and block.settings.video_url != blank -%}
            <div
              class="video-slider-card"
              style="animation-delay: {{ forloop.index0 | times: 0.2 }}s;"
              {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}
            >
              <video
                playsinline
                muted
                loop
                preload="metadata"
                aria-label="{{ block.settings.alt | default: 'Video' | escape }}"
                {% if block.settings.autoplay %}autoplay{% endif %}
              >
                <source src="{{ block.settings.video_url }}" type="video/quicktime">
                <source src="{{ block.settings.video_url }}" type="video/mp4">
              </video>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "+8.000 personas ya eligieron Kevin Jewelry"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h0", "label": "Extra grande" },
        { "value": "h1", "label": "Grande" },
        { "value": "h2", "label": "Mediano" },
        { "value": "h3", "label": "Pequeño" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho completo",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de color",
      "options": [
        { "value": "scheme-1", "label": "Claro" },
        { "value": "scheme-2", "label": "Oscuro" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "URL del video"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Texto alternativo"
        },
        {
          "type": "checkbox",
          "id": "autoplay",
          "label": "Reproducir automáticamente",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video slider",
      "blocks": [
        { "type": "video", "settings": { "video_url": "https://cdn.shopify.com/videos/c/o/v/a5b07de02bdf46ada3c90b0fa3606920.mp4", "autoplay": true } },
        { "type": "video", "settings": { "video_url": "https://cdn.shopify.com/videos/c/o/v/48068a3a8a4848a1ba9f27fc44e63051.mp4", "autoplay": true } },
        { "type": "video", "settings": { "video_url": "https://cdn.shopify.com/videos/c/o/v/96ac85af477d42afb156fb28421be602.mov", "autoplay": true } },
        { "type": "video", "settings": { "video_url": "https://cdn.shopify.com/videos/c/o/v/b7acfab11811412182fbd0d8942f9c57.mov", "autoplay": true } }
      ]
    }
  ]
}
{% endschema %}
