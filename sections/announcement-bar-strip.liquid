{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .utility-bar--full-width .announcement-bar__message {
    font-size: calc(var(--font-heading-scale) * 1.4rem);
  }
  @media screen and (min-width: 750px) {
    .utility-bar--full-width .announcement-bar__message {
      font-size: calc(var(--font-heading-scale) * 1.5rem);
    }
  }
  .utility-bar--full-width .utility-bar__inner {
    width: 100%;
    max-width: none;
    margin: 0;
    padding-left: 0;
    padding-right: 0;
    box-sizing: border-box;
  }
  .utility-bar--full-width .announcement-bar-marquee-mask {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    box-sizing: border-box;
  }
  .announcement-bar-strip__wrapper {
    position: relative;
    z-index: 1;
    margin-top: 0;
    margin-bottom: 0;
  }
{%- endstyle -%}

<div
  class="announcement-bar-strip__wrapper utility-bar utility-bar--full-width color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% endif %}"
>
  <div class="utility-bar__inner">
    {%- if section.blocks.size == 1 -%}
      <div class="announcement-bar" role="region" aria-label="{{ 'sections.header.announcement' | t }}" {{ section.blocks.first.shopify_attributes }}>
        {%- if section.blocks.first.settings.text != blank -%}
          {%- if section.blocks.first.settings.link != blank -%}
            <a href="{{ section.blocks.first.settings.link }}" class="announcement-bar__link link link--text focus-inset animate-arrow">
          {%- endif -%}
          <p class="announcement-bar__message h5">
            <span>{{ section.blocks.first.settings.text | escape }}</span>
            {%- if section.blocks.first.settings.link != blank -%}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            {%- endif -%}
          </p>
          {%- if section.blocks.first.settings.link != blank -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- elsif section.blocks.size > 1 -%}
      <div class="announcement-bar announcement-bar--marquee" role="region" aria-label="{{ 'sections.announcements.announcement_bar' | t }}">
        <style>
          .announcement-bar--marquee { flex: 1; min-width: 0; }
          .announcement-bar--marquee .announcement-bar-marquee-mask { overflow: hidden; width: 100%; }
          .announcement-bar--marquee .announcement-bar-marquee-track {
            display: flex;
            gap: 3rem;
            width: max-content;
            animation: announcement-bar-marquee-{{ section.id }} {{ section.settings.change_slides_speed | default: 5 | times: 7 }}s linear infinite;
          }
          .announcement-bar--marquee .announcement-bar-marquee-track:hover { animation-play-state: paused; }
          @keyframes announcement-bar-marquee-{{ section.id }} {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
          }
          .announcement-bar--marquee .announcement-bar-marquee-item { flex-shrink: 0; white-space: nowrap; }
        </style>
        <div class="announcement-bar-marquee-mask">
          <div class="announcement-bar-marquee-track">
            {%- for copy in (1..2) -%}
              {%- for block in section.blocks -%}
                <div class="announcement-bar-marquee-item" {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}>
                  <div class="announcement-bar__announcement">
                    {%- if block.settings.text != blank -%}
                      {%- if block.settings.link != blank -%}
                        <a href="{{ block.settings.link }}" class="announcement-bar__link link link--text focus-inset">
                      {%- endif -%}
                      <p class="announcement-bar__message h5">
                        <span>{{ block.settings.text | escape }}</span>
                        {%- if block.settings.link != blank -%}
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        {%- endif -%}
                      </p>
                      {%- if block.settings.link != blank -%}
                        </a>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar strip",
  "class": "announcement-bar-strip",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "default": 5,
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar strip",
      "blocks": [{ "type": "announcement" }]
    }
  ]
}
{% endschema %}
